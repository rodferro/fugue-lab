{
  "name": "fugue-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Write a fugue subject on a piano roll; get a generated exposition.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "build:single": "node scripts/build-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "tsx --test src/engine/*.test.ts src/cli/*.test.ts",
    "cli": "tsx src/cli/fugue-cli.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
